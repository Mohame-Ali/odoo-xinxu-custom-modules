<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action -->
    <record id="action_mission_order" model="ir.actions.act_window">
        <field name="name">Ordres de mission</field>
        <field name="res_model">mission.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez un nouvel ordre de mission.
            </p>
            <p>
                Les ordres de mission permettent de demander et suivre les déplacements professionnels.
                Les notes de frais peuvent être liées à un ordre de mission approuvé.
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_mission_root" name="Missions" parent="hr_expense.menu_hr_expense_root" sequence="15"/>
    <menuitem id="menu_mission_order" name="Ordres de mission" parent="menu_mission_root" action="action_mission_order"/>

    <!-- ====================== VUE LISTE ====================== -->
    <record id="view_mission_order_list" model="ir.ui.view">
        <field name="name">mission.order.list</field>
        <field name="model">mission.order</field>
        <field name="arch" type="xml">
            <list string="Ordres de mission">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="state" widget="badge"
                       decoration-danger="state=='refused'"
                       decoration-success="state=='approved'"/>
                <field name="approved_budget" sum="Budget total"/>
                <field name="spent_amount" sum="Dépensé"/>
                <field name="remaining_budget" sum="Reste"/>
            </list>
        </field>
    </record>

    <!-- ====================== VUE FORMULAIRE ====================== -->
    <record id="view_mission_order_form" model="ir.ui.view">
        <field name="name">mission.order.form</field>
        <field name="model">mission.order</field>
        <field name="arch" type="xml">
            <form string="Ordre de mission">
                <header>
                    <!-- Soumettre : action réservée au propriétaire de la mission -->
                    <button name="action_submit" string="Soumettre" type="object"
                            invisible="state != 'draft' or not is_mission_owner"
                            class="btn-primary"/>
                    <!-- Approuver : responsable, sur une mission qui n'est pas la sienne (sauf admin) -->
                    <button name="action_approve" string="Approuver" type="object"
                            groups="xinxu_mission.group_mission_manager"
                            invisible="state != 'submitted' or (is_mission_owner and not is_system_admin)"
                            class="btn-success"/>
                    <!-- Refuser : responsable, sur une mission qui n'est pas la sienne (sauf admin) -->
                    <button name="action_refuse" string="Refuser" type="object"
                            groups="xinxu_mission.group_mission_manager"
                            invisible="state != 'submitted' or (is_mission_owner and not is_system_admin)"
                            class="btn-danger"/>
                    <!-- Remettre en brouillon : action réservée au propriétaire de la mission -->
                    <button name="action_reset_to_draft" string="Remettre en brouillon" type="object"
                            invisible="state != 'refused' or not is_mission_owner"/>
                    <!-- Annuler l'approbation : responsable, sur une mission qui n'est pas la sienne (sauf admin) -->
                    <button name="action_cancel_approval"
                            string="Annuler l'approbation"
                            type="object"
                            groups="xinxu_mission.group_mission_manager"
                            invisible="state != 'approved' or (is_mission_owner and not is_system_admin)"
                            class="btn-warning"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,submitted,approved,refused" readonly="1"/>
                </header>
                <sheet>
                    <!-- Indicateurs de permission (calculés, masqués) -->
                    <field name="is_mission_owner" invisible="1"/>
                    <field name="is_mission_manager" invisible="1"/>
                    <field name="is_system_admin" invisible="1"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="employee_id" options="{'no_create': True}"
                                       readonly="state == 'approved'"/>
                                <field name="function" readonly="state == 'approved'"/>
                                <field name="personal_address" readonly="state == 'approved'"/>
                                <field name="accompanied_by" readonly="state == 'approved'"/>
                                <field name="particular_modalities" readonly="state == 'approved'"/>
                            </group>
                            <group>
                                <field name="request_date" readonly="state == 'approved'"/>
                                <field name="state" readonly="1"/>
                                <field name="manager_id" readonly="1"/>
                                <field name="approval_date" readonly="1"/>
                            </group>
                        </group>
                    </div>

                    <notebook>
                        <!-- Destinations -->
                        <page string="Destinations">
                            <field name="stage_ids" mode="list,form"
                                   readonly="state == 'approved'">
                                <list string="Étapes" editable="bottom">
                                    <field name="destination"/>
                                    <field name="departure_datetime"/>
                                    <field name="return_datetime"/>
                                    <field name="departure_location"/>
                                    <field name="return_location"/>
                                </list>
                                <form string="Étape">
                                    <group>
                                        <field name="destination"/>
                                        <field name="departure_datetime"/>
                                        <field name="return_datetime"/>
                                    </group>
                                    <group string="Lieux">
                                        <field name="departure_location"/>
                                        <field name="return_location"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <!-- Motif et transport -->
                        <page string="Motif et transport">
                            <group>
                                <field name="purpose" widget="textarea"
                                       readonly="state == 'approved'"/>
                                <field name="transport_mode"
                                       readonly="state == 'approved'"/>
                                <field name="vehicle_brand"
                                      invisible="transport_mode != 'personal_vehicle'"
                                      required="transport_mode == 'personal_vehicle'"
                                      readonly="state == 'approved'"/>
                                <field name="vehicle_plate"
                                      invisible="transport_mode != 'personal_vehicle'"
                                      readonly="state == 'approved'"/>
                                <field name="personal_vehicle_reimbursement"
                                      invisible="transport_mode != 'personal_vehicle'"
                                      readonly="state == 'approved'"/>
                            </group>
                        </page>

                        <!-- Budget -->
                        <page string="Budget">
                            <group>
                                <group>
                                    <field name="estimated_costs"
                                           readonly="state == 'approved'"/>
                                    <!-- Budget approuvé : visible par tous, modifiable uniquement
                                         par un responsable et seulement à l'état « Soumis » -->
                                    <field name="approved_budget"
                                           readonly="state != 'submitted' or not is_mission_manager"/>
                                </group>
                                <group>
                                    <field name="spent_amount"/>
                                    <field name="remaining_budget"/>
                                </group>
                            </group>
                        </page>

                        <!-- Notes de frais -->
                        <page string="Notes de frais">
                            <field name="expense_ids" mode="list,form">
                                <list string="Dépenses liées">
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="total_amount"/>
                                    <field name="state" widget="badge"/>
                                </list>
                                <form string="Dépense">
                                    <group>
                                        <field name="name"/>
                                        <field name="product_id"/>
                                        <field name="total_amount"/>
                                        <field name="state"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

</odoo>
