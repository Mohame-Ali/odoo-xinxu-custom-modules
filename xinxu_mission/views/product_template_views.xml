<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_expense_category" model="ir.ui.view">
        <field name="name">product.template.form.expense.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="expense_category" invisible="not can_be_expensed"/>
            </xpath>
        </field>
    </record>
</odoo>
