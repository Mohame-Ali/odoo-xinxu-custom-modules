<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="sales_management_dashboard.SalesDashboardTemplate" owl="1">
        <div class="o_sales_dashboard p-4" style="max-height: 90vh; overflow-y: auto;">
            <h2 class="dashboard-title text-center mb-4">📊 Sales Dashboard</h2>

            <div class="kpi-toolbar mb-4">
                <div class="toolbar-field">
                    <label>Global Filter:</label>
                    <select id="global_filter" t-on-change="onChangeGlobalFilter"
                            t-model="state.filters.global_filter">
                        <option value="select_period">Select Period</option>
                        <option value="this_week">This Week</option>
                        <option value="this_month">This Month</option>
                        <option value="this_year">This Year</option>
                        <option value="custom">Custom Range</option>
                    </select>
                </div>

                <div class="toolbar-field" t-if="state.filters.global_filter === 'custom'">
                    <label>From:</label>
                    <input type="date" t-on-change="onChangeCustomFrom" />
                </div>
                <div class="toolbar-field" t-if="state.filters.global_filter === 'custom'">
                    <label>To:</label>
                    <input type="date" t-on-change="onChangeCustomTo" />
                </div>

                <div class="toolbar-field">
                    <label>Limit:</label>
                    <select id="global_limit" t-on-change="onChangeGlobalLimit"
                            t-model="state.filters.limit">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                        <option value="25">25</option>
                        <option value="30">30</option>
                    </select>
                </div>
            </div>

            <!-- ============ RANGEE 1 : CYCLE DE VENTE ============ -->
            <p class="kpi-group-label">Sales Pipeline</p>
            <div class="row g-3 mb-2">
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card kpi--slate is-clickable" role="button" t-on-click="viewQuotations">
                        <div class="kpi-icon"><i class="fa fa-file-text-o"/></div>
                        <div class="kpi-text">
                            <div class="kpi-label">Quotations</div>
                            <div class="kpi-value"><t t-esc="state.data.sales_info.quotation"/></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card kpi--blue is-clickable" role="button" t-on-click="viewOrders">
                        <div class="kpi-icon"><i class="fa fa-shopping-cart"/></div>
                        <div class="kpi-text">
                            <div class="kpi-label">Sale Orders</div>
                            <div class="kpi-value"><t t-esc="state.data.sales_info.sale_orders"/></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card kpi--amber is-clickable" role="button" t-on-click="viewToInvoiceOrders">
                        <div class="kpi-icon"><i class="fa fa-credit-card"/></div>
                        <div class="kpi-text">
                            <div class="kpi-label">Orders to Invoice</div>
                            <div class="kpi-value"><t t-esc="state.data.sales_info.orders_to_invoice"/></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card kpi--green is-clickable" role="button" t-on-click="viewFullyInvoicedOrders">
                        <div class="kpi-icon"><i class="fa fa-check-circle"/></div>
                        <div class="kpi-text">
                            <div class="kpi-label">Fully Invoiced</div>
                            <div class="kpi-value"><t t-esc="state.data.sales_info.orders_fully_invoiced"/></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============ RANGEE 2 : INDICATEURS FINANCIERS ============ -->
            <p class="kpi-group-label mt-3">Financial Indicators</p>
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card kpi--indigo">
                        <div class="kpi-icon"><i class="fa fa-percent"/></div>
                        <div class="kpi-text">
                            <div class="kpi-label">Order Conversion Rate</div>
                            <div class="kpi-value"><t t-esc="state.data.sales_info.conversion_rate"/>%</div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card kpi--teal">
                        <div class="kpi-icon"><i class="fa fa-calendar-o"/></div>
                        <div class="kpi-text">
                            <div class="kpi-label">Total Revenue MTD</div>
                            <div class="kpi-value"><t t-esc="state.data.sales_info.total_revenue_mtd"/></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card kpi--navy">
                        <div class="kpi-icon"><i class="fa fa-line-chart"/></div>
                        <div class="kpi-text">
                            <div class="kpi-label">Total Revenue YTD</div>
                            <div class="kpi-value"><t t-esc="state.data.sales_info.total_revenue_ytd"/></div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="kpi-card kpi--cyan">
                        <div class="kpi-icon"><i class="fa fa-calculator"/></div>
                        <div class="kpi-text">
                            <div class="kpi-label">Average Order Value</div>
                            <div class="kpi-value"><t t-esc="state.data.sales_info.avg_order_value"/></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head">Sales by Team</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <t t-if="state.filters.global_filter == 'select_period'">
                            <select class="form-select w-auto" t-on-change="onChangeTeamFilter" t-att-value="state.filters.team_filter">
                                <option value="this_week">This Week</option>
                                <option value="this_month">This Month</option>
                                <option value="this_year">This Year</option>
                            </select>
                            </t>
                        </div>
                        <div class="card-body">
                            <div class="chart-box"><canvas id="salesByTeamChart"></canvas></div>
                            <table class="table table-bordered table-sm table-hover mt-3">
                                <thead class="table-light">
                                    <tr>
                                        <th>Team</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.sales_by_team || []" t-as="team" t-key="team.id">
                                        <tr class="clickable-row" t-on-click="() => goToRecord('crm.team', team.id)">
                                            <td t-esc="team.name"/>
                                            <td class="text-end fw-bold" t-esc="team.amount_display"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head">Sales by Person</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <t t-if="state.filters.global_filter == 'select_period'">
                            <select class="form-select w-auto" t-on-change="onChangePersonFilter" t-att-value="state.filters.person_filter">
                                <option value="this_week">This Week</option>
                                <option value="this_month">This Month</option>
                                <option value="this_year">This Year</option>
                            </select>
                            </t>
                        </div>
                        <div class="card-body">
                            <div class="chart-box"><canvas id="salesByPersonChart"></canvas></div>
                            <table class="table table-bordered table-sm table-hover mt-3">
                                <thead class="table-light">
                                    <tr><th>Salesperson</th><th class="text-end">Amount</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.sales_by_person || []" t-as="person" t-key="person.id">
                                        <tr class="clickable-row" t-on-click="() => goToRecord('res.users', person.id)">
                                            <td t-esc="person.name"/>
                                            <td class="text-end fw-bold" t-esc="person.amount_display"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head dash-head--good">Top Selling Products</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex gap-2">
                                <t t-if="state.filters.global_filter == 'select_period'">
                                <select class="form-select form-select-sm w-auto" t-on-change="onChangeProductFilter" t-att-value="state.filters.product_filter">
                                    <option value="this_week">This Week</option>
                                    <option value="this_month">This Month</option>
                                    <option value="this_year">This Year</option>
                                </select>
                                </t>
                                <select class="form-select form-select-sm w-auto" t-on-change="onChangeProductCategory">
                                    <option value="">All Categories</option>
                                    <t t-foreach="state.data.product_categories || []" t-as="cat" t-key="cat.id">
                                        <option t-att-value="cat.id" t-esc="cat.name"/>
                                    </t>
                                </select>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="chart-box"><canvas id="topProductsChart"></canvas></div>
                            <table class="table table-bordered table-sm table-hover mt-3">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-end">Quantity Sold</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.top_products || []" t-as="prod" t-key="prod.id">
                                        <tr class="clickable-row" t-on-click="() => goToRecord('product.product', prod.id)">
                                            <td t-esc="prod.name"/>
                                            <td class="text-end fw-bold" t-esc="prod.qty"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head dash-head--bad">Least Selling Products</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex gap-2">
                                <t t-if="state.filters.global_filter == 'select_period'">
                                <select class="form-select form-select-sm w-auto" t-on-change="onChangeLowProductFilter" t-att-value="state.filters.low_product_filter">
                                    <option value="this_week">This Week</option>
                                    <option value="this_month">This Month</option>
                                    <option value="this_year">This Year</option>
                                </select>
                                </t>
                                <select class="form-select form-select-sm w-auto" t-on-change="onChangeLowProductCategory">
                                    <option value="">All Categories</option>
                                    <t t-foreach="state.data.product_categories || []" t-as="cat" t-key="cat.id">
                                        <option t-att-value="cat.id" t-esc="cat.name"/>
                                    </t>
                                </select>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="chart-box"><canvas id="lowestProductsChart"></canvas></div>
                            <table class="table table-bordered table-sm table-hover mt-3">
                                <thead class="table-light">
                                    <tr><th>Product</th><th class="text-end">Quantity Sold</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.lowest_products || []" t-as="prod" t-key="prod.id">
                                        <tr class="clickable-row" t-on-click="() => goToRecord('product.product', prod.id)">
                                            <td t-esc="prod.name"/>
                                            <td class="text-end fw-bold" t-esc="prod.qty"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head">Top Customers</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <t t-if="state.filters.global_filter == 'select_period'">
                            <select class="form-select w-auto" t-on-change="onChangeCustomerFilter" t-att-value="state.filters.customer_filter">
                                <option value="this_week">This Week</option>
                                <option value="this_month">This Month</option>
                                <option value="this_year">This Year</option>
                            </select>
                            </t>
                        </div>
                        <div class="card-body">
                            <table class="table table-bordered table-sm table-hover">
                                <thead class="table-light">
                                    <tr><th>Customer</th><th class="text-end">Amount</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.top_customers || []" t-as="cust" t-key="cust.id">
                                        <tr class="clickable-row" t-on-click="() => goToRecord('res.partner', cust.id)">
                                            <td t-esc="cust.name"/>
                                            <td class="text-end fw-bold" t-esc="cust.amount_display"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head">Order Status</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <t t-if="state.filters.global_filter == 'select_period'">
                            <select class="form-select w-auto" t-on-change="onChangeOrderFilter" t-att-value="state.filters.order_filter">
                                <option value="this_week">This Week</option>
                                <option value="this_month">This Month</option>
                                <option value="this_year">This Year</option>
                            </select>
                            </t>
                        </div>
                        <div class="card-body">
                            <div class="chart-box"><canvas id="orderStatusChart"></canvas></div>
                            <table class="table table-bordered table-sm table-hover mt-3">
                                <thead class="table-light">
                                    <tr><th>Status</th><th class="text-end">Count</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.order_status || []" t-as="order" t-key="order.status">
                                        <tr>
                                            <td t-esc="order.status"/>
                                            <td class="text-end fw-bold" t-esc="order.count"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head">Invoice Status</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <t t-if="state.filters.global_filter == 'select_period'">
                            <select class="form-select w-auto" t-on-change="onChangeInvoiceFilter" t-att-value="state.filters.invoice_filter">
                                <option value="this_week">This Week</option>
                                <option value="this_month">This Month</option>
                                <option value="this_year">This Year</option>
                            </select>
                            </t>
                        </div>
                        <div class="card-body">
                            <div class="chart-box"><canvas id="invoiceStatusChart"></canvas></div>
                            <table class="table table-bordered table-sm table-hover mt-3">
                                <thead class="table-light">
                                    <tr><th>Status</th><th class="text-end">Count</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.invoice_status || []" t-as="inv" t-key="inv.status">
                                        <tr>
                                            <td t-esc="inv.status"/>
                                            <td class="text-end fw-bold" t-esc="inv.count"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head dash-head--bad">Overdue Customers</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <t t-if="state.filters.global_filter == 'select_period'">
                            <select class="form-select w-auto" t-on-change="onChangeOverdueFilter" t-att-value="state.filters.team_filter">
                                <option value="this_week">This Week</option>
                                <option value="this_month">This Month</option>
                                <option value="this_year">This Year</option>
                            </select>
                            </t>
                        </div>
                        <div class="card-body">
                            <div class="chart-box"><canvas id="overdueCustomersChart"></canvas></div>
                            <table class="table table-bordered table-sm table-hover mt-3">
                                <thead class="table-light">
                                    <tr><th>Customer</th><th class="text-end">Amount</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.overdue_customers || []" t-as="cust" t-key="cust.id">
                                        <tr class="clickable-row" t-on-click="() => goToRecord('res.partner', cust.id)">
                                            <td t-esc="cust.name"/>
                                            <td class="text-end fw-bold" t-esc="cust.amount_display"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head">New vs Returning Customers</div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <t t-if="state.filters.global_filter == 'select_period'">
                            <select class="form-select w-auto" t-on-change="onChangeNvRFilter" t-att-value="state.filters.team_filter">
                                <option value="this_week">This Week</option>
                                <option value="this_month">This Month</option>
                                <option value="this_year">This Year</option>
                            </select>
                            </t>
                        </div>
                        <div class="card-body">
                            <div class="chart-box"><canvas id="newVsReturningChart"></canvas></div>
                            <t t-set="customerData" t-value="state.data.new_vs_returning"/>
                                <div t-if="customerData and customerData.details">
                                    <h5 class="mt-3">New Customers</h5>
                                    <table class="table table-bordered table-sm table-hover mt-2">
                                        <thead class="table-light">
                                            <tr><th>Customer</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="customerData.details.new" t-as="cust" t-key="cust_index">
                                                <td class="clickable-row" t-on-click="() => this.goToRecord('res.partner', cust.id)" t-esc="cust.name"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <h5 class="mt-3">Returning Customers</h5>
                                    <table class="table table-bordered table-sm table-hover mt-2">
                                        <thead class="table-light">
                                            <tr><th>Customer</th></tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="customerData.details.returning" t-as="cust" t-key="cust_index">
                                                <td class="clickable-row" t-on-click="() => this.goToRecord('res.partner', cust.id)" t-esc="cust.name"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Project Metrics Section -->
            <h4 class="fw-bold text-primary mb-3 mt-2">🏗️ Project Analytics</h4>

            <div class="d-flex align-items-center gap-2 mb-3">
                <label class="fw-semibold mb-0">Filter by Year:</label>
                <select class="form-select w-auto" t-on-change="onChangeProjectYearFilter">
                    <option value="">All Years</option>
                    <t t-foreach="state.data.project_available_years || []" t-as="yr" t-key="yr">
                        <option t-att-value="yr" t-esc="yr"/>
                    </t>
                </select>
            </div>

            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head">Projects per Year</div>
                        <div class="card-body">
                            <div class="chart-box" style="height: 220px;"><canvas id="projectsPerYearChart"></canvas></div>
                            <table class="table table-bordered table-sm table-hover mt-3">
                                <thead class="table-light">
                                    <tr>
                                        <th>Year</th>
                                        <th class="text-end">Projects</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.projects_per_year || []" t-as="row" t-key="row.year">
                                        <tr>
                                            <td t-esc="row.year"/>
                                            <td class="text-end fw-bold" t-esc="row.count"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-8 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head">Revenue per Project</div>
                        <div class="card-body">
                            <table class="table table-bordered table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Project</th>
                                        <th class="text-end">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.revenue_per_project || []" t-as="proj" t-key="proj.id">
                                        <tr class="clickable-row" t-on-click="() => goToRecord('xinxu.project', proj.id)">
                                            <td t-esc="proj.name"/>
                                            <td class="text-end fw-bold" t-esc="proj.revenue"/>
                                        </tr>
                                    </t>
                                    <tr t-if="(state.data.revenue_per_project || []).length === 0">
                                        <td colspan="2" class="text-center text-muted">No project data available.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header dash-head">Average Revenue per Person per Project</div>
                        <div class="card-body">
                            <table class="table table-bordered table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Project</th>
                                        <th>Salesperson</th>
                                        <th class="text-end">Revenue</th>
                                        <th class="text-end">Avg / Person</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.avg_revenue_per_person || []" t-as="proj" t-key="proj.id">
                                        <t t-foreach="proj.persons" t-as="person" t-key="person.name">
                                            <tr>
                                                <td t-if="person_index === 0"
                                                    t-att-rowspan="proj.persons.length"
                                                    class="align-middle fw-bold clickable-row"
                                                    t-on-click="() => goToRecord('xinxu.project', proj.id)"
                                                    t-esc="proj.project"/>
                                                <td t-esc="person.name"/>
                                                <td class="text-end" t-esc="person.revenue"/>
                                                <td t-if="person_index === 0"
                                                    t-att-rowspan="proj.persons.length"
                                                    class="text-end align-middle fw-bold"
                                                    t-esc="proj.avg_per_person"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <tr t-if="(state.data.avg_revenue_per_person || []).length === 0">
                                        <td colspan="4" class="text-center text-muted">No data available.</td>
                                    </tr>
